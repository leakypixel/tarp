[user]
  email = hi@leakypixel.net
  name = Craig Fletcher
	signingkey = 7FC0014B237501360B7E543B19DC3F477DBF7D65

[push]
  default = upstream

[merge]
  ff = no
  tool = vimdiff

[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  ui = true
  pager = true

[credential]
  # Keeping these here for easy switching between machines. First is arch, second is deb. 
  # /usr/share/doc/git/contrib/credential/gnome-keyring/git-credential-gnome-keyring
  # /usr/share/git/credential/gnome-keyring/git-credential-gnome-keyring
  # helper = /usr/share/doc/git/contrib/credential/gnome-keyring/git-credential-gnome-keyring

[alias]
  co = checkout
  b = branch
  a = add
  s = status
  p = push origin
  hr = reset --hard @{u}
  c = commit -vp
  fi = diff-tree --no-commit-id --name-only -r
  l = log --oneline --abbrev-commit --branches=* --graph --decorate --color
  up = !git fetch origin && git pull
  wtf = blame
  sync = !git pull && git push
  sy = !git pull && git push
  ssy = "!f() { before=$(git rev-parse -q --verify refs/stash 2>/dev/null || true); git stash push --include-untracked -m auto-ssy >/dev/null || return $?; after=$(git rev-parse -q --verify refs/stash 2>/dev/null || true); created=0; [ -n \"$after\" ] && [ \"$before\" != \"$after\" ] && created=1; git pull && git push; status=$?; if [ $created -eq 1 ]; then git stash pop || status=$?; fi; return $status; }; f"
  whoops = !git add -A && git commit --amend --no-edit && git push -f
  mm = "!branch=${MAIN_BRANCH:-master}; git checkout \"$branch\" && git pull && git merge - && git push"
  rb = "!branch=${MAIN_BRANCH:-master}; git checkout \"$branch\" && git pull && git checkout - && git rebase \"$branch\""

[core]
  editor = vim
  whitespace = trailing-space,space-before-tab
	excludesfile = ~/.gitfiles/.gitignore_global

[commit]
  template = ~/.gitfiles/.gitmessage
	gpgsign = true

[diff]
  algorithm = patience
	tool = vimdiff

[help]
  autocorrect = 0

[credential]
  helper = store
[pull]
	rebase = true
[gpg]
	program = gpg
