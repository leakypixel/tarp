rofi.color-enabled: true
rofi.modi: combi,drun,run,window,ssh,calc,websearch:~/.config/rofi/scripts/applet_websearch
rofi.terminal: alacritty
rofi.ssh-command: {terminal} -e "{ssh-client} {host}"
rofi.run-shell-command: {terminal} -e "{cmd}"
rofi.sidebar-mode: false
rofi.separator-style: solid
rofi.hide-scrollbar: true
rofi.dpi: 96
rofi.show-icons: true
rofi.drun-icon-theme: Suru++
rofi.font: Mononoki Nerd Font Mono 12
rofi.theme: ~/.config/rofi/theme.rasi
rofi.lines: 5
